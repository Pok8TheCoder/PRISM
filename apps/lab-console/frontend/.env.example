# UI-only mode (no backend)
VITE_FORCE_MOCK=true

# REST prefix — leave default for Vite proxy, or point at a remote BFF:
# VITE_API_BASE_URL=/api
# VITE_API_BASE_URL=http://127.0.0.1:8790/api

# Vite dev-server proxy target when using `/api` (default :8790)
# VITE_PROXY_TARGET=http://127.0.0.1:8790

# Dev server port (default 5173)
# VITE_DEV_PORT=5173
