# Data and Weights
# Ignore large raw and processed archives, pcaps, binetflow, and splits
data/raw/
data/processed/
data/splits_*/
*.tar.bz2
*.pcap
*.binetflow

# Track schema and small reference splits
!data/*.json
!data/splits/*.npz

# Ignore intermediate epoch weights and temporary experiment folders
weights/**/world_model_epoch*.pt
weights/gen7_dilated_v1/
weights/gen7_fixABCDEFG/
weights/gen7_synthetic_augmented/
weights/test_gpu_run/
weights/universal_gen5*/
weights/universal_gen6*/
weights/universal_gen7_converged/
weights/universal_gen7_final/
weights/universal_gen7_test*/

# Track Gen 7 best model weights and evaluation deliverables
!weights/universal_gen7_dilated/world_model_best.pt
!weights/universal_gen7_dilated/*.json
!weights/*.pkl
!weights/*.json


# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
